.{
    .name = .fluxion_physics3d,
    .version = "0.1.0",
    .minimum_zig_version = "0.16.0",
    .fingerprint = 0xa4f40c7176468be3,
    .dependencies = .{
        // `Vec3`, `Quat` and `Mat3`, and the arithmetic on them. Pinned to
        // the commit every other package names, so the engine's copy of
        // these types is this one: a path here and a pin there would be two
        // copies of one library, and two `Vec3`s the compiler will not mix.
        .fluxion_math = .{
            .url = "git+https://github.com/kisstp2006/fluxion-math#92afdbddbf930369265d24136402c7eb5dd8f70e",
            .hash = "fluxion_math-0.1.0-dfpZBeNUBAAwUMriLKaOTRBWGFmfY53_jyYuMUxkPYek",
        },

        // Generational handles: what a body and a shape are known by, so a
        // game holding one to a body that has been destroyed finds nothing
        // rather than whatever took its slot.
        .fluxion_id = .{
            .url = "git+https://github.com/kisstp2006/fluxion-id#a52c29dfe5ac0a49a5d5469cdc1a4fb96b799ccc",
            .hash = "fluxion_id-0.1.0--9Hv-nGFAQAW36SvJvMB6L1nUNErZzh7JC0-nRPlrotw",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "README.md",
        "LICENSE",
    },
}
